  "status": {
    "$comment": "ЛР№4: ENUM description.status — ровно 6 значений. Цвет берётся из семантических токенов активной палитры, поэтому бейджи переключаются вместе с ней.",
    "incomplete":         { "label": "Не хватает атрибутов", "bg": "warning-soft", "fg": "warning", "contour": "продавец" },
    "draft":              { "label": "Черновик",             "bg": "surface-alt",  "fg": "text-muted", "contour": "продавец" },
    "pending_moderation": { "label": "На модерации",         "bg": "info-soft",    "fg": "info",     "contour": "продавец, модератор" },
    "blocked":            { "label": "Заблокировано",        "bg": "error-soft",   "fg": "error",    "contour": "продавец, модератор" },
    "returned":           { "label": "Возвращено на правку", "bg": "accent-soft",  "fg": "on-accent-soft", "contour": "продавец" },
    "published":          { "label": "Опубликовано",         "bg": "success-soft", "fg": "success",  "contour": "продавец, модератор, администратор" }
  },

  "confidence": {
    "$comment": "ЛР№4: ENUM description.confidence — ровно 3 дискретных уровня, не процент и не шкала. ОГР-2: покупателю не показывается.",
    "low":    { "label": "Низкая уверенность",   "bg": "error-soft",   "fg": "error",   "priority": 1 },
    "medium": { "label": "Средняя уверенность",  "bg": "warning-soft", "fg": "warning", "priority": 2 },
    "high":   { "label": "Высокая уверенность",  "bg": "success-soft", "fg": "success", "priority": 3 }
  },

  "return_reason": {
    "$comment": "ЛР№4: ENUM причин возврата — ровно 4 значения, в UI это радиокнопки.",
    "size_mismatch":    "Не подошёл размер",
    "not_as_described": "Не соответствует описанию",
    "defect":           "Брак",
    "changed_mind":     "Передумал(а)"
  },

  "typography": {
    "font-web": "Inter, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "font-ios": "SF Pro Text, -apple-system, sans-serif",
    "font-android": "Roboto, sans-serif",
    "font-mono": "'JetBrains Mono', ui-monospace, monospace",
    "scale": {
      "h1": { "size": 40, "line": 48, "weight": 700, "tracking": "-0.02em" },
      "h2": { "size": 30, "line": 38, "weight": 700, "tracking": "-0.01em" },
      "h3": { "size": 24, "line": 32, "weight": 600, "tracking": "0" },
      "h4": { "size": 19, "line": 26, "weight": 600, "tracking": "0" },
      "body-lg": { "size": 17, "line": 26, "weight": 400, "tracking": "0" },
      "body": { "size": 16, "line": 24, "weight": 400, "tracking": "0", "note": "минимум для основного текста — требование ЛР№1 п.9.3 (Ольга Петровна, 48 лет)" },
      "body-sm": { "size": 14, "line": 20, "weight": 400, "tracking": "0" },
      "caption": { "size": 13, "line": 18, "weight": 400, "tracking": "0.01em" },
      "label": { "size": 13, "line": 16, "weight": 600, "tracking": "0.04em", "transform": "uppercase" }
    }
  },

  "spacing": { "$comment": "шаг 8 pt; 4 — только для внутренних отступов бейджей и иконок",
    "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64, "9": 96 },

  "radius": { "none": 0, "sm": 6, "md": 10, "lg": 16, "xl": 24, "pill": 999 },

  "elevation": {
    "0": "none",
    "1": "0 1px 2px rgba(16,24,40,.06), 0 1px 3px rgba(16,24,40,.10)",
    "2": "0 4px 8px -2px rgba(16,24,40,.10), 0 2px 4px -2px rgba(16,24,40,.06)",
    "3": "0 12px 16px -4px rgba(16,24,40,.08), 0 4px 6px -2px rgba(16,24,40,.03)"
  },

  "motion": {
    "fast": "150ms cubic-bezier(.4,0,.2,1)",
    "base": "250ms cubic-bezier(.4,0,.2,1)",
    "slow": "400ms cubic-bezier(.2,0,0,1)",
    "$comment": "при prefers-reduced-motion длительности обнуляются"
  },

  "touch": {
    "ios-min": 44, "android-min": 48,
    "$comment": "ЛР№1 п.2.3 — крупные тач-зоны; применяется и к планшетной веб-версии (ЛР№2 п.1.3)"
  },

  "grid": {
    "$comment": "Расчёты по методике ЛР№5: ширина контейнера = колонки × N + гаттеры × (N−1)",
    "breakpoints": [
      { "range": "1440+",    "artboard": 1440, "container": 1320, "columns": 12, "gutter": 24, "column": 88,   "margin": 60, "cards": 4, "filters": "сайдбар 3 колонки" },
      { "range": "992–1199", "artboard": 1024, "container": 984,  "columns": 12, "gutter": 24, "column": 60,   "margin": 20, "cards": 3, "filters": "сайдбар 3 колонки" },
      { "range": "768–991",  "artboard": 768,  "container": 720,  "columns": 8,  "gutter": 24, "column": 69,   "margin": 24, "cards": 3, "filters": "кнопка + drawer" },
      { "range": "576–767",  "artboard": 600,  "container": 552,  "columns": 8,  "gutter": 16, "column": 55,   "margin": 24, "cards": 2, "filters": "кнопка + bottom sheet" },
      { "range": "400–575",  "artboard": 414,  "container": "stretch", "columns": 4, "gutter": 16, "column": 83.5, "margin": 16, "cards": 2, "filters": "липкая панель снизу" },
      { "range": "320–399",  "artboard": 360,  "container": "stretch", "columns": 4, "gutter": 16, "column": 70,   "margin": 16, "cards": 2, "filters": "липкая панель снизу" }
    ],
    "devices": [
      { "name": "iPhone SE (3rd)", "w": 375, "h": 667, "columns": 4, "margin": 16, "platform": "iOS",     "note": "минимальный кейс; проверка AC-02.1" },
      { "name": "iPhone 15 Pro",   "w": 393, "h": 852, "columns": 4, "margin": 16, "platform": "iOS",     "note": "safe area, Dynamic Island" },
      { "name": "Pixel 7",         "w": 412, "h": 915, "columns": 4, "margin": 16, "platform": "Android", "note": "Material, системная кнопка «Назад»" },
      { "name": "iPad mini",       "w": 744, "h": 1133, "columns": 8, "margin": 24, "platform": "iPadOS", "note": "2 колонки карточек, side rail" },
      { "name": "iPad Pro 11\"",   "w": 834, "h": 1194, "columns": 12, "margin": 32, "platform": "iPadOS", "note": "master-detail" }
    ]
  },

  "constraints": {
    "$comment": "Технические ограничения из ЛР№4 — применяются в макетах как реальные, а не придуманные данные",
    "summary_max_chars": 90,
    "order_number_pattern": "^MS-\\d{4}-\\d{6}$",
    "order_number_example": "MS-2026-000154",
    "phone_pattern": "^\\+375\\d{9}$",
    "batch_max_items": 20,
    "upload_max_mb": 10,
    "moderation_comment_required_on_return": true
  }
}
