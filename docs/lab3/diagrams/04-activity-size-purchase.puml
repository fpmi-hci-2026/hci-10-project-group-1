@startuml 04-activity-size-purchase
' Задание 4. Диаграмма деятельности: подбор размера и покупка товара
title Подбор размера и оформление заказа покупателем

skinparam backgroundColor #FFFFFF
skinparam shadowing false

|#F2F5FA|Покупатель|
start
:Открыть карточку товара;

|#FFF9E6|Ассистент по размеру|
if (Параметры размера\nесть в профиле?) then (нет)
  |#F2F5FA|Покупатель|
  :Открыть форму ввода параметров\n(не более 3 полей);
  :Ввести параметры и подтвердить;
  |#FFF9E6|Ассистент по размеру|
  :Сохранить параметры в профиль;
else (да)
endif

:Загрузить размерную сетку бренда;
:Собрать оценки посадки из отзывов;

if (Отзывов с оценкой посадки >= 5\nили сетка задана?) then (нет)
  |#F2F5FA|Покупатель|
  :Увидеть сообщение\n«Данных о посадке\nпока недостаточно»;
  :Выбрать размер самостоятельно;
else (да)
  |#FFF9E6|Ассистент по размеру|
  :Рассчитать рекомендованный размер;
  :Сформировать пояснение\n«маломерит / большемерит»;
  |#F2F5FA|Покупатель|
  :Увидеть рекомендацию\nи пояснение о посадке;
  if (Рекомендованный размер\nесть в наличии?) then (нет)
    :Увидеть ближайший доступный\nразмер с пометкой;
    :Выбрать размер вручную;
  else (да)
    :Принять подставленный размер;
  endif
endif

:Добавить товар в корзину;
:Перейти к оформлению заказа;

|#EAF4EC|Сервис заказов|
:Показать условия и срок возврата;
:Предложить пункт самовывоза\nкак способ по умолчанию;

|#F2F5FA|Покупатель|
:Выбрать способ доставки;
:Выбрать способ оплаты\n(карта / при получении / ЕРИП);

|#EAF4EC|Сервис заказов|
:Зарезервировать остаток товара;

if (Оплата онлайн?) then (да)
  |#FDECE3|Платёжный шлюз|
  :Провести платёж;
  if (Платёж прошёл?) then (нет)
    |#EAF4EC|Сервис заказов|
    :Снять резерв остатка;
    |#F2F5FA|Покупатель|
    :Увидеть сообщение об ошибке\nи выбрать другой способ оплаты;
    stop
  else (да)
  endif
else (нет)
  |#EAF4EC|Сервис заказов|
  :Пометить заказ\n«Оплата при получении»;
endif

|#EAF4EC|Сервис заказов|
:Создать заказ и передать\nв службу доставки;
:Запустить отсчёт срока возврата;

|#F2F5FA|Покупатель|
:Получить подтверждение заказа\nи срок возврата;
stop

@enduml
