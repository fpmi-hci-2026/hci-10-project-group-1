@startuml 07-c4-component-description
' Задание 7. C4 Model. Уровень 3: Компоненты сервиса генерации описаний
!include <C4/C4_Component>

title Модель C4, уровень 3 — Компоненты контейнера «Сервис генерации описаний»

Container(catalog, "Сервис каталога", "Kotlin, Spring", "Инициирует генерацию после сохранения атрибутов")
Container(descr, "Сервис описаний", "Kotlin, Spring", "Хранит описания и версии")
ContainerQueue(bus, "Шина событий", "Kafka")
System_Ext(llm, "LLM-провайдер")
ContainerDb(pg, "Основная БД", "PostgreSQL")

Container_Boundary(gen, "Сервис генерации описаний") {
  Component(api, "Generation API", "FastAPI router", "Принимает запрос на генерацию, возвращает статус и идентификатор описания")
  Component(orch, "Оркестратор генерации", "Python", "Управляет последовательностью: проверка атрибутов → промпт → вызов модели → проверка формулировок")
  Component(attr, "Проверка атрибутов", "Python", "Сравнивает заполненные поля со справочником обязательных атрибутов категории")
  Component(prompt, "Сборщик промптов", "Python, Jinja2", "Подставляет атрибуты товара в версионированный шаблон промпта для категории")
  Component(llmc, "Клиент LLM", "Python, httpx", "Вызов внешней модели, таймауты, повторы, учёт расхода токенов")
  Component(conf, "Расчёт уверенности", "Python", "Оценивает долю утверждений, подтверждённых атрибутами-источниками")
  Component(rules, "Проверка формулировок", "Python", "Детерминированный поиск запрещённых формулировок по активным правилам")
  Component(sum, "Сборщик кратких версий", "Python", "Формирует summary не длиннее 90 символов для рекомендаций и поиска")
  Component(pub, "Публикатор событий", "Python, aiokafka", "Публикует события о сформированном и заблокированном описании")
  Component(repo, "Репозиторий правил", "Python, SQLAlchemy", "Читает активные правила генерации и шаблоны промптов")
}

Rel(catalog, api, "POST /generate", "REST")
Rel(api, orch, "Запускает генерацию")
Rel(orch, attr, "Проверяет полноту атрибутов")
Rel(orch, prompt, "Запрашивает промпт для категории")
Rel(prompt, repo, "Читает шаблон промпта")
Rel(orch, llmc, "Передаёт промпт")
Rel(llmc, llm, "HTTPS, таймаут 20 с")
Rel(orch, sum, "Формирует краткую версию")
Rel(orch, conf, "Рассчитывает уровень уверенности")
Rel(orch, rules, "Проверяет текст")
Rel(rules, repo, "Читает активные правила")
Rel(repo, pg, "SELECT", "SQLAlchemy")
Rel(orch, descr, "Сохраняет описание и версии", "REST")
Rel(orch, pub, "Сообщает об исходе")
Rel(pub, bus, "Публикует события", "Kafka")

SHOW_LEGEND()
@enduml
