@startuml 04-class-order
title Диаграмма классов 3. Заказы, оплата, доставка и возвраты
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members

enum СтатусЗаказа {
  СОЗДАН
  ОПЛАЧЕН
  ПЕРЕДАН_В_ДОСТАВКУ
  ГОТОВ_К_ВЫДАЧЕ
  ВЫДАН
  ОТМЕНЁН
}

enum СпособОплаты {
  КАРТА_ОНЛАЙН
  ПРИ_ПОЛУЧЕНИИ
  ЕРИП
}

enum СпособДоставки {
  ПУНКТ_САМОВЫВОЗА
  КУРЬЕР
  БЕЛПОЧТА
}

enum СтатусЗаявки {
  СОЗДАНА
  ТОВАР_СДАН
  НА_РАССМОТРЕНИИ
  ОДОБРЕНА
  ОТКЛОНЕНА
  СРЕДСТВА_ВОЗВРАЩЕНЫ
}

enum ПричинаВозврата {
  НЕ_ПОДОШЁЛ_РАЗМЕР
  НЕ_СООТВЕТСТВУЕТ_ОПИСАНИЮ
  БРАК
  ПЕРЕДУМАЛ
}

class Корзина {
  - id: UUID
  - покупательId: UUID
  - обновленаВ: DateTime
  + добавить(в: ВариантТовара, кол: int): void
  + итого(): Money
}

class Заказ {
  - id: UUID
  - номер: String
  - статус: СтатусЗаказа
  - созданВ: DateTime
  - срокВозвратаДо: Date
  + итого(): Money
  + можетБытьВозвращён(): boolean
  + отменить(): void
}

class ПозицияЗаказа {
  - вариантId: UUID
  - количество: int
  - ценаНаМоментЗаказа: Money
  + сумма(): Money
}

class Платёж {
  - id: UUID
  - способ: СпособОплаты
  - сумма: Money
  - внешнийId: String
  - проведёнВ: DateTime
  + успешен(): boolean
  + вернутьСредства(сумма: Money): void
}

class Доставка {
  - id: UUID
  - способ: СпособДоставки
  - трекНомер: String
  - ожидаемаяДата: Date
  + текущийСтатус(): String
}

class ПунктВыдачи {
  - id: UUID
  - адрес: String
  - городId: UUID
  - принимаетВозвраты: boolean
}

class ЗаявкаНаВозврат {
  - id: UUID
  - заказId: UUID
  - причина: ПричинаВозврата
  - статус: СтатусЗаявки
  - созданаВ: DateTime
  - обмен: boolean
  + требуетФото(): boolean
  + одобрить(): void
  + отклонить(комментарий: String): void
}

class ФотоКЗаявке {
  - url: String
  - загруженоВ: DateTime
}

class ПравилаВозврата {
  - категорияId: UUID
  - срокДней: int
  - возвратЗапрещён: boolean
  + текстДляПокупателя(): String
}

Корзина "1" --> "0..1" Заказ : оформляется в >
Заказ "1" *-- "1..*" ПозицияЗаказа
Заказ "1" --> "0..1" Платёж
Заказ "1" --> "1" Доставка
Доставка "0..*" --> "0..1" ПунктВыдачи
Заказ "1" --> "0..*" ЗаявкаНаВозврат
ЗаявкаНаВозврат "1" *-- "0..*" ФотоКЗаявке
ЗаявкаНаВозврат ..> ПравилаВозврата : проверяется по >
Заказ ..> ПравилаВозврата : задаёт срок >

note right of ЗаявкаНаВозврат
  Фото обязательно только для
  причин БРАК и
  НЕ_СООТВЕТСТВУЕТ_ОПИСАНИЮ
  (US-11, AC-11.4)
end note

note bottom of ПравилаВозврата
  Единый источник правил:
  изменение отражается и в
  карточке, и при оформлении
  заказа (US-12, AC-12.3)
end note

@enduml
