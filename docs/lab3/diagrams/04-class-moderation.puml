@startuml 04-class-moderation
title Диаграмма классов 5. Модерация, правила и контроль качества
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members

enum РешениеМодерации {
  ОДОБРЕНО
  ВОЗВРАЩЕНО
  ЗАБЛОКИРОВАНО
}

enum ТипНарушения {
  ЗАПРЕЩЁННАЯ_ФОРМУЛИРОВКА
  НЕСООТВЕТСТВИЕ_ФОТО
  НЕПОЛНЫЕ_АТРИБУТЫ
  ПОВТОРНОЕ_НАРУШЕНИЕ
}

class Администратор {
  - id: UUID
  - логин: String
  - роль: String
  + взятьВРаботу(з: ЗадачаМодерации): boolean
}

class ОчередьМодерации {
  - размер: int
  + следующая(): ЗадачаМодерации
  + отсортироватьПоУверенности(): List<ЗадачаМодерации>
  + заблокированные(): List<ЗадачаМодерации>
}

class ЗадачаМодерации {
  - id: UUID
  - описаниеId: UUID
  - уверенность: String
  - взятаВРаботу: DateTime
  - блокировкаДо: DateTime
  + захвачена(): boolean
  + освободить(): void
}

class РешениеМодератора {
  - id: UUID
  - решение: РешениеМодерации
  - комментарий: String
  - принятоВ: DateTime
  - длительностьСек: int
}

class ШаблонКомментария {
  - id: UUID
  - текст: String
  - типНарушения: ТипНарушения
  - активен: boolean
}

class ПравилоГенерации {
  - id: UUID
  - запрещённаяФормулировка: String
  - активно: boolean
}

class НарушениеПродавца {
  - id: UUID
  - продавецId: UUID
  - тип: ТипНарушения
  - зафиксированоВ: DateTime
}

class РейтингКачестваКарточек {
  - продавецId: UUID
  - доляВозвратовКарточек: Decimal
  - доляБлокировок: Decimal
  - заПериод: String
  + требуетВнимания(): boolean
}

class Жалоба {
  - id: UUID
  - источник: String
  - описаниеId: UUID
  - текст: String
  - рассмотрена: boolean
}

Администратор "1" --> "0..*" ЗадачаМодерации : обрабатывает >
ОчередьМодерации "1" o-- "0..*" ЗадачаМодерации
ЗадачаМодерации "1" --> "0..1" РешениеМодератора : завершается >
РешениеМодератора "0..*" --> "0..1" ШаблонКомментария : использует >
ШаблонКомментария "0..*" --> "1" ТипНарушения
ЗадачаМодерации ..> ПравилоГенерации : проверяется по >
РешениеМодератора ..> НарушениеПродавца : порождает >
НарушениеПродавца "0..*" --> "1" РейтингКачестваКарточек : учитывается в >
Жалоба "0..*" --> "0..1" ЗадачаМодерации : порождает >
Администратор "1" --> "0..*" ПравилоГенерации : настраивает >

note right of ЗадачаМодерации
  Захват задачи исключает
  параллельную обработку
  двумя модераторами
  (US-08, AC-08.7)
end note

note bottom of НарушениеПродавца
  Более трёх блокировок за 30 дней
  создают запись о повторном
  нарушении (US-09, AC-09.6)
end note

@enduml
