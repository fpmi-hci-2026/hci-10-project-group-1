@startuml 07-c4-context
' Задание 7. C4 Model. Уровень 1: Контекст системы
!include <C4/C4_Context>

title Модель C4, уровень 1 — Контекст системы «МаркетШоп.by»

AddElementTag("core", $bgColor="#22304A", $fontColor="#FFFFFF", $borderColor="#101C2E")

Person(buyer, "Покупатель", "Житель Республики Беларусь, покупает одежду и обувь онлайн; 82,6% — со смартфона, 58,7% — вечером")
Person(seller, "Продавец", "Малый белорусский бренд или ИП; публикует 15–20 позиций раз в 1–2 недели")
Person(admin, "Администратор-модератор", "Сотрудник площадки; проверяет 100–200 карточек в день")

System(marketshop, "МаркетШоп.by", "Маркетплейс одежды и обуви с автоматической генерацией и персонализацией описаний товаров", $tags="core")

System_Ext(llm, "LLM-провайдер", "Внешняя языковая модель; формирует черновик текста по атрибутам товара")
System_Ext(erip, "ЕРИП", "Единое расчётное информационное пространство")
System_Ext(acquirer, "Банк-эквайер", "Приём платежей по картам БЕЛКАРТ, Visa, Mastercard")
System_Ext(delivery, "Службы доставки", "Белпочта, СДЭК, Европочта: доставка и пункты выдачи")
System_Ext(push, "Сервис push-уведомлений", "FCM / APNs")

Rel(buyer, marketshop, "Ищет товары, подбирает размер, заказывает, оформляет возврат", "HTTPS")
Rel(seller, marketshop, "Загружает товары, проверяет сгенерированные описания, обрабатывает заявки на возврат", "HTTPS")
Rel(admin, marketshop, "Модерирует карточки, настраивает правила генерации", "HTTPS")

Rel(marketshop, llm, "Запрашивает черновик описания по атрибутам товара (без персональных данных)", "HTTPS")
Rel(marketshop, erip, "Инициирует оплату", "HTTPS")
Rel(marketshop, acquirer, "Проводит платёж, получает вебхуки", "HTTPS, 3-D Secure")
Rel(marketshop, delivery, "Создаёт отправления, получает статусы и список пунктов выдачи", "HTTPS")
Rel(marketshop, push, "Отправляет уведомления о статусе заказа и заявки", "HTTPS")

SHOW_LEGEND()
@enduml
