@startuml 04-class-customer
title Диаграмма классов 4. Покупатель, персонализация и отзывы
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members

enum ОценкаПосадки {
  МАЛОМЕРИТ
  СООТВЕТСТВУЕТ
  БОЛЬШЕМЕРИТ
}

enum ТипБлока {
  СПЕЦИАЛЬНО_ДЛЯ_ВАС
  ПОХОЖИЕ_ТОВАРЫ
  С_ЭТИМ_ПОКУПАЮТ
}

class Покупатель {
  - id: UUID
  - имя: String
  - телефон: String
  - городId: UUID
  - зарегистрированВ: DateTime
  + авторизован(): boolean
}

class ПрофильПредпочтений {
  - любимыеКатегории: List<UUID>
  - предпочитаемыеМатериалы: List<String>
  - ценовойДиапазон: Range<Money>
  + обновитьПоСобытию(с: СобытиеПросмотра): void
}

class ПараметрыРазмера {
  - ростСм: int
  - обхватГрудиСм: int
  - длинаСтопыСм: Decimal
  - привычныйРазмерВерха: String
  + заполнены(): boolean
}

class ИсторияПросмотров {
  - записи: List<СобытиеПросмотра>
  + последние(n: int): List<Товар>
}

class СобытиеПросмотра {
  - товарId: UUID
  - произошлоВ: DateTime
  - длительностьСек: int
}

class Избранное {
  - товары: List<UUID>
  + добавить(т: UUID): void
  + удалить(т: UUID): void
}

class РекомендательныйБлок {
  - id: UUID
  - тип: ТипБлока
  - критерийПерсонализации: String
  - обновлёнВ: DateTime
  + товары(лимит: int): List<Товар>
}

class ДвижокРекомендаций <<service>> {
  + сформироватьЛенту(п: Покупатель): List<РекомендательныйБлок>
  + похожиеТовары(т: Товар): List<Товар>
  + популярноеВРегионе(городId: UUID): List<Товар>
}

class АссистентПоРазмеру <<service>> {
  + рекомендовать(т: Товар, п: ПараметрыРазмера): РекомендацияРазмера
  + достаточноДанных(т: Товар): boolean
}

class РекомендацияРазмера {
  - размер: String
  - пояснение: String
  - отклонение: Decimal
  - уверенность: String
}

class Отзыв {
  - id: UUID
  - товарId: UUID
  - оценка: int
  - текст: String
  - оценкаПосадки: ОценкаПосадки
  - созданВ: DateTime
  + полезен(): int
}

class ФотоКОтзыву {
  - url: String
}

Покупатель "1" *-- "1" ПрофильПредпочтений
Покупатель "1" *-- "0..1" ПараметрыРазмера
Покупатель "1" *-- "1" ИсторияПросмотров
Покупатель "1" *-- "1" Избранное
ИсторияПросмотров "1" *-- "0..*" СобытиеПросмотра
Покупатель "1" --> "0..*" Отзыв : оставляет >
Отзыв "1" *-- "0..*" ФотоКОтзыву
ДвижокРекомендаций ..> ПрофильПредпочтений : читает >
ДвижокРекомендаций ..> ИсторияПросмотров : читает >
ДвижокРекомендаций ..> РекомендательныйБлок : формирует >
АссистентПоРазмеру ..> ПараметрыРазмера : читает >
АссистентПоРазмеру ..> Отзыв : агрегирует оценки посадки >
АссистентПоРазмеру ..> РекомендацияРазмера : создаёт >

note right of АссистентПоРазмеру
  Рекомендация формируется только
  при >= 5 отзывов с оценкой посадки
  либо заданной размерной сетке
  (US-03, AC-03.4)
end note

note bottom of ДвижокРекомендаций
  При нехватке данных лента
  заполняется популярным
  в регионе (US-01, AC-01.7)
end note

@enduml
