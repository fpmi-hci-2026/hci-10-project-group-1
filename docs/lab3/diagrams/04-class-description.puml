@startuml 04-class-description
title Диаграмма классов 2. Генерация и модерация описаний
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members

enum СтатусМодерации {
  ЧЕРНОВИК
  НА_МОДЕРАЦИИ
  ОПУБЛИКОВАНО
  ВОЗВРАЩЕНО_ПРОДАВЦУ
  ЗАБЛОКИРОВАНО
}

enum УровеньУверенности {
  НИЗКИЙ
  СРЕДНИЙ
  ВЫСОКИЙ
}

enum ТипВерсии {
  ДЛЯ_КАРТОЧКИ
  ДЛЯ_РЕКОМЕНДАЦИЙ
}

class ОписаниеТовара {
  - id: UUID
  - товарId: UUID
  - статус: СтатусМодерации
  - уверенность: УровеньУверенности
  - причинаБлокировки: String
  + текущаяВерсия(т: ТипВерсии): ВерсияОписания
  + добавитьВерсию(в: ВерсияОписания): void
  + заблокировать(причина: String): void
  + опубликовать(): void
}

class ВерсияОписания {
  - номер: int
  - тип: ТипВерсии
  - текст: String
  - авторПравки: String
  - созданаВ: DateTime
  + долиИзменённыхСимволов(пред: ВерсияОписания): Decimal
}

class ШаблонПромпта {
  - id: UUID
  - категорияId: UUID
  - тон: String
  - текстШаблона: String
  - версия: int
  + подставить(атрибуты: Map): String
}

class ГенераторОписаний <<service>> {
  + сформироватьЧерновик(т: Товар): ОписаниеТовара
  + сформироватьSummary(о: ОписаниеТовара): ВерсияОписания
  + рассчитатьУверенность(о: ОписаниеТовара): УровеньУверенности
}

class КлиентLLM <<gateway>> {
  - модель: String
  - таймаут: Duration
  + выполнить(промпт: String): String
}

class ПроверкаАтрибутов <<service>> {
  + недостающиеПоля(т: Товар): List<String>
  + генерацияРазрешена(т: Товар): boolean
}

class ПроверкаФормулировок <<service>> {
  + найденныеНарушения(текст: String): List<ПравилоГенерации>
  + текстДопустим(текст: String): boolean
}

class ПравилоГенерации {
  - id: UUID
  - запрещённаяФормулировка: String
  - пояснение: String
  - активно: boolean
  + найденаВ(текст: String): boolean
}

class ОценкаДостоверности {
  - утверждение: String
  - атрибутИсточник: String
  - подтверждено: boolean
}

ОписаниеТовара "1" *-- "1..*" ВерсияОписания
ОписаниеТовара "1" o-- "0..*" ОценкаДостоверности
ГенераторОписаний ..> ОписаниеТовара : создаёт >
ГенераторОписаний ..> ШаблонПромпта : применяет >
ГенераторОписаний ..> КлиентLLM : вызывает >
ГенераторОписаний ..> ПроверкаАтрибутов : предусловие >
ГенераторОписаний ..> ПроверкаФормулировок : постусловие >
ПроверкаФормулировок ..> ПравилоГенерации : читает >
ПроверкаФормулировок ..> ОписаниеТовара : блокирует >

note bottom of ОценкаДостоверности
  Каждое утверждение описания
  сопоставляется с атрибутом-
  источником (US-02, AC-02.3)
end note

note right of ПроверкаФормулировок
  Детерминированная проверка
  после генерации: нельзя
  полагаться на то, что LLM
  сама не употребит запрещённую
  формулировку (US-09)
end note

@enduml
