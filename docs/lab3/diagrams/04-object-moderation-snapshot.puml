@startuml 04-object-moderation-snapshot
title Диаграмма объектов 1. Снимок состояния: карточка на модерации
skinparam backgroundColor #FFFFFF
skinparam shadowing false
hide empty members

object "виктор : Продавец" as seller {
  id = 7c1e-…-b204
  названиеБренда = "NordLine"
  унп = 590123456
