  авторПравки = "виктор"
  текст = "Тёплая куртка из полиэстера, посадка свободная…"
}

object "в3 : ВерсияОписания" as v3 {
  номер = 2
  тип = ДЛЯ_РЕКОМЕНДАЦИЙ
  авторПравки = "генератор"
  текст = "Зимняя куртка, свободная посадка"
}

object "задача881 : ЗадачаМодерации" as task {
  уверенность = "низкая"
  взятаВРаботу = 2026-10-05 09:14
  блокировкаДо = 2026-10-05 09:29
}

object "марина : Администратор" as admin {
  логин = "m.moderator"
  роль = "content-moderator"
}

seller --> product
product --> a1
product --> a2
product --> desc
desc --> v1
desc --> v2
desc --> v3
task --> desc
admin --> task

note bottom of desc
  Снимок иллюстрирует требование
  AC-05.7: исходный черновик
  генератора (в1) сохраняется
  рядом с правкой продавца (в2)
end note

note right of task
  Низкая уверенность генератора
  выводит задачу в начало очереди
  (US-08, AC-08.1)
end note

@enduml
