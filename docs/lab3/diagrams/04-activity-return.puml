@startuml 04-activity-return
' Задание 4. Диаграмма деятельности: оформление возврата или обмена
title Оформление возврата или обмена (барьер №1 по данным опроса — 39,1%)

skinparam backgroundColor #FFFFFF
skinparam shadowing false

|#F2F5FA|Покупатель|
start
:Получить заказ;
if (Товар подошёл?) then (да)
  :Оставить отзыв\nс оценкой посадки;
  stop
else (нет)
endif

:Открыть раздел «Мои заказы»\nили страницу статуса доставки;
:Выбрать «Оформить возврат\nили обмен»;

|#EAF4EC|Сервис возвратов|
:Проверить срок возврата\nпо правилам товара;
if (Срок возврата истёк?) then (да)
  |#F2F5FA|Покупатель|
  :Увидеть причину отказа\nи ссылку на правила;
  stop
else (нет)
endif
:Показать список причин возврата;

|#F2F5FA|Покупатель|
:Выбрать причину;

|#EAF4EC|Сервис возвратов|
if (Причина требует фото?\n(брак, несоответствие описанию)) then (да)
  |#F2F5FA|Покупатель|
  :Прикрепить фотографии;
  |#EAF4EC|Сервис возвратов|
else (нет)
endif

:Создать заявку на возврат;
:Присвоить код причины\nдля отчётности;
:Определить пункт приёма\nи срок сдачи товара;

|#F2F5FA|Покупатель|
:Увидеть адрес пункта приёма\nи срок сдачи;
:Сдать товар в пункт приёма;

|#FFF4EC|Продавец|
:Получить заявку в кабинете;
:Осмотреть товар;
if (Товар соответствует\nусловиям возврата?) then (нет)
  :Отклонить заявку\nс комментарием;
  |#FFF9E6|Администратор-модератор|
  :Рассмотреть спор;
  if (Решение в пользу\nпокупателя?) then (да)
    |#EAF4EC|Сервис возвратов|
    :Перевести заявку\nв статус «Одобрено»;
  else (нет)
    |#F2F5FA|Покупатель|
    :Получить отказ\nс обоснованием;
    stop
  endif
else (да)
  |#EAF4EC|Сервис возвратов|
  :Перевести заявку\nв статус «Одобрено»;
endif

|#EAF4EC|Сервис возвратов|
if (Тип обращения?) then (возврат)
  :Инициировать возврат средств;
else (обмен)
  :Создать заказ на замену;
endif
:Зафиксировать код причины\nв метрике качества описаний;

|#F2F5FA|Покупатель|
:Получить push-уведомление\nо статусе заявки;
stop

@enduml
