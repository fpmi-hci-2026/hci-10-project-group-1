@startuml 04-object-recommendation
title Диаграмма объектов 2. Снимок состояния: персонализированная лента Анастасии
skinparam backgroundColor #FFFFFF
skinparam shadowing false
hide empty members

object "анастасия : Покупатель" as buyer {
  имя = "Анастасия"
  городId = Минск
  зарегистрированВ = 2026-03-11
}

object "профиль : ПрофильПредпочтений" as pref {
  любимыеКатегории = [Платья, Верхняя одежда]
  предпочитаемыеМатериалы = [вискоза, хлопок]
  ценовойДиапазон = 40…120 BYN
}

object "размеры : ПараметрыРазмера" as size {
  ростСм = 168
  обхватГрудиСм = 86
  привычныйРазмерВерха = "S"
}

object "блок1 : РекомендательныйБлок" as b1 {
  тип = СПЕЦИАЛЬНО_ДЛЯ_ВАС
  критерийПерсонализации = "размер S + вискоза + лето"
  обновлёнВ = 2026-10-05 20:41
}

object "блок2 : РекомендательныйБлок" as b2 {
  тип = ПОХОЖИЕ_ТОВАРЫ
  критерийПерсонализации = "просмотр: Платье Мадрид"
  обновлёнВ = 2026-10-05 20:41
}

object "платьеМадрид : Товар" as p1 {
  название = "Платье летнее Мадрид"
  цена = 89.00 BYN
}

object "сводка : ВерсияОписания" as s1 {
  тип = ДЛЯ_РЕКОМЕНДАЦИЙ
  текст = "Лёгкая вискоза, не просвечивает, посадка по фигуре"
}

object "просмотр1 : СобытиеПросмотра" as e1 {
  товарId = платьеМадрид
  произошлоВ = 2026-10-04 21:02
  длительностьСек = 48
}

buyer --> pref
buyer --> size
buyer --> b1
buyer --> b2
b1 --> p1
p1 --> s1
buyer --> e1
e1 ..> p1

note bottom of s1
  В ленте показывается краткая
  версия описания длиной
  не более 90 символов
  (US-01, AC-01.2)
end note

@enduml
