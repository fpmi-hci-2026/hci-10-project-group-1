@startuml 04-class-catalog
title Диаграмма классов 1. Каталог товаров
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members

enum Сезон {
  ЗИМА
  ВЕСНА_ОСЕНЬ
  ЛЕТО
  ВСЕСЕЗОННЫЙ
}

class Бренд {
  - id: UUID
  - название: String
  - сделаноВБеларуси: boolean
  + активныхТоваров(): int
}

class Категория {
  - id: UUID
  - название: String
  - уровень: int
  + предки(): List<Категория>
  + листовая(): boolean
}

class Товар {
  - id: UUID
  - артикул: String
  - название: String
  - цена: Money
  - сезон: Сезон
  - странаПроизводства: String
  + атрибутыПолны(): boolean
  + доступенКПокупке(): boolean
  + минимальнаяЦенаЗа30Дней(): Money
}

class ВариантТовара {
  - id: UUID
  - размер: String
  - цвет: String
  - штрихкод: String
  + вНаличии(): boolean
}

class Остаток {
  - складId: UUID
  - количество: int
  - зарезервировано: int
  + доступно(): int
  + зарезервировать(кол: int): boolean
}

class АтрибутТовара {
  - код: String
  - значение: String
  - обязательный: boolean
  + заполнен(): boolean
}

class СправочникАтрибутов {
  - код: String
  - отображаемоеИмя: String
  - типЗначения: String
  - обязательныйДляКатегории: boolean
}

class ФотоТовара {
  - url: String
  - порядок: int
  - основное: boolean
}

class РазмернаяСетка {
  - id: UUID
  - типИзделия: String
  - отклонениеПосадки: Decimal
  + размерПоПараметрам(п: ПараметрыРазмера): String
}

Бренд "1" --> "0..*" Товар : выпускает >
Категория "1" --> "0..*" Товар : содержит >
Категория "0..1" --> "0..*" Категория : родитель >
Товар "1" *-- "1..*" ВариантТовара : имеет >
ВариантТовара "1" *-- "1..*" Остаток : хранится >
Товар "1" *-- "1..*" АтрибутТовара : описывается >
АтрибутТовара "0..*" --> "1" СправочникАтрибутов : типизируется >
Товар "1" *-- "1..*" ФотоТовара : иллюстрируется >
Бренд "1" --> "0..*" РазмернаяСетка : задаёт >
Товар "0..*" --> "0..1" РазмернаяСетка : использует >

note right of СправочникАтрибутов
  Состав обязательных атрибутов
  задаётся администратором и
  применяется без пересборки
  приложения (US-06, AC-06.4)
end note

@enduml
