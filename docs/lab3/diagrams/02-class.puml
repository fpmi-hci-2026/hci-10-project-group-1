@startuml 02-class
' Задание 2. Диаграмма классов: ядро предметной области
title Ядро предметной области: товар, описание и его версии

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members

enum СтатусМодерации {
  ЧЕРНОВИК
  НА_МОДЕРАЦИИ
  ОПУБЛИКОВАНО
  ВОЗВРАЩЕНО_ПРОДАВЦУ
  ЗАБЛОКИРОВАНО
}

enum УровеньУверенности {
  НИЗКИЙ
  СРЕДНИЙ
  ВЫСОКИЙ
}

enum ТипВерсии {
  ДЛЯ_КАРТОЧКИ
  ДЛЯ_РЕКОМЕНДАЦИЙ
}

class Продавец {
  - id: UUID
  - названиеБренда: String
  - унп: String
  - городСклада: String
  - рейтинг: Decimal
  + загрузитьТовар(т: Товар): void
  + отправитьНаМодерацию(т: Товар): void
}

class Товар {
  - id: UUID
  - название: String
  - цена: Money
  - странаПроизводства: String
  - остаток: int
  + атрибутыПолны(): boolean
  + доступенКПокупке(): boolean
}

class Категория {
  - id: UUID
  - название: String
  - уровень: int
  + полныйПуть(): String
}

class АтрибутТовара {
  - код: String
  - значение: String
  - обязательный: boolean
}

class РазмернаяСетка {
  - бренд: String
  - типИзделия: String
  + размерПоПараметрам(п: ПараметрыПокупателя): Размер
  + отклонениеПосадки(): Decimal
}

class ОписаниеТовара {
  - id: UUID
  - статус: СтатусМодерации
  - уверенность: УровеньУверенности
  - созданоВ: DateTime
  + текущаяВерсия(т: ТипВерсии): ВерсияОписания
  + добавитьВерсию(в: ВерсияОписания): void
  + заблокировать(причина: String): void
}

class ВерсияОписания {
  - номер: int
  - тип: ТипВерсии
  - текст: String
  - авторПравки: String
  - созданаВ: DateTime
  + длина(): int
}

class ГенераторОписаний <<service>> {
  + сформироватьЧерновик(т: Товар): ОписаниеТовара
  + рассчитатьУверенность(о: ОписаниеТовара): УровеньУверенности
}

class ПроверкаАтрибутов <<service>> {
  - обязательныеПоля: List<String>
  + недостающиеПоля(т: Товар): List<String>
  + генерацияРазрешена(т: Товар): boolean
}

class ПравилоГенерации {
  - id: UUID
  - запрещённаяФормулировка: String
  - активно: boolean
  + найденаВ(текст: String): boolean
}

class ЗадачаМодерации {
  - id: UUID
  - взятаВРаботу: DateTime
  - модератор: String
  + одобрить(): void
  + вернутьПродавцу(комментарий: String): void
}

Продавец "1" --> "0..*" Товар : публикует >
Товар "0..*" --> "1" Категория : принадлежит >
Товар "1" *-- "1..*" АтрибутТовара : описывается >
Товар "0..*" --> "0..1" РазмернаяСетка : использует >
Товар "1" --> "0..1" ОписаниеТовара : имеет >
ОписаниеТовара "1" *-- "1..*" ВерсияОписания : содержит >
ГенераторОписаний ..> Товар : читает атрибуты
ГенераторОписаний ..> ОписаниеТовара : создаёт >
ГенераторОписаний ..> ПроверкаАтрибутов : использует >
ПроверкаАтрибутов ..> АтрибутТовара : анализирует >
ГенераторОписаний ..> ПравилоГенерации : применяет >
ЗадачаМодерации "1" --> "1" ОписаниеТовара : проверяет >

note top of ПроверкаАтрибутов
  Функциональный объект из
  объектной модели ЛР№2:
  блокирует генерацию при
  неполных атрибутах (US-06)
end note

note bottom of ВерсияОписания
  Две версии формируются из одного
  черновика и различаются длиной
  и тоном (US-05, AC-05.5)
end note

@enduml
