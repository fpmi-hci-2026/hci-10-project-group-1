@startuml 05-es-big-picture
' Задание 5. Event Storming. Уровень 1: Big Picture
title Event Storming — Big Picture: события предметной области «МаркетШоп.by»

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam rectangle {
  BorderColor #8A6A3A
  FontSize 12
  BackgroundColor<<event>> #FFB366
  BackgroundColor<<pivotal>> #FF8C42
  BackgroundColor<<hotspot>> #E05C5C
  BackgroundColor<<external>> #F2A9B8
  FontColor<<hotspot>> #FFFFFF
}
skinparam package {
  BackgroundColor #FBFAF7
  BorderColor #BBBBBB
  FontStyle bold
}

legend top left
  <b>Нотация Event Storming</b>
  |<back:#FFB366>   </back>| событие предметной области (глагол в прошедшем времени) |
  |<back:#FF8C42>   </back>| опорное (pivotal) событие — граница фазы |
  |<back:#E05C5C>   </back>| противоречие (hotspot) — требует решения |
  |<back:#F2A9B8>   </back>| событие внешней системы |
endlegend

